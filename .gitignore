# Secrets: API keys live here, never in git
.env

# Python virtual environment and caches
.venv/
__pycache__/
*.pyc

# Recorded audio and eval run outputs (can be large or personal)
audio/
runs/

# Decision logger run log and off switch (local only)
.claude/decision-logger/
.claude/settings.local.json

# Code-docs hook run log, lock and off switch (local only)
.claude/code-docs/

# Generated from data/faq.json by faq.py
data/*.db
