# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Required: the assistant's LLM (gpt-5.4-mini) and the eval judge (gpt-5.5)
OPENAI_API_KEY=

# Required for voice: Azure Speech (the F0 free tier is enough). Region = your resource's region code.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Optional: ElevenLabs (Scribe v2 STT, better Georgian TTS). Without it, leave the providers on azure.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=          # a premade voice (ELEVENLABS_VOICE=ready)
ELEVENLABS_CLONE_VOICE_ID=    # your own Instant Voice Clone (ELEVENLABS_VOICE=clone)

# azure (default) or elevenlabs; Azure is always the fallback
TTS_PROVIDER=azure
STT_PROVIDER=azure
ELEVENLABS_VOICE=ready
